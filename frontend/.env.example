# ============================================================
#  Affiliate Hub — Frontend Configuration
#  Copy file này thành `.env.local` nếu cần override API URL.
#  Mặc định frontend gọi BE tại http://localhost:8088 (qua Next.js rewrite).
#  Không cần đổi nếu chạy local cả FE lẫn BE cùng máy.
# ============================================================

# URL Backend API — chỉ cần đặt khi deploy FE và BE khác domain / khác host
NEXT_PUBLIC_API_URL=http://localhost:8088
